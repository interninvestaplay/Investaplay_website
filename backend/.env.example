# ==========================================
# Backend Environment Configuration Example
# ==========================================
NODE_ENV=development
PORT=4000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-db-password
DB_NAME=quizgame

# JWT Authentication Secrets (Generate 64+ char random keys for production)
JWT_ACCESS_SECRET=replace-with-random-secret
JWT_REFRESH_SECRET=replace-with-another-random-secret

# CORS Allowed Client Origins (Comma-separated)
# In development: defaults to http://localhost:8081,http://localhost:8082,http://localhost:19006
# In production: specify your production frontend domains:
# CLIENT_ORIGIN=https://quizzyfox.com,https://app.quizzyfox.com
CLIENT_ORIGIN=http://localhost:8081,http://localhost:8082,http://localhost:19006

# Google OAuth Credentials (Backend token verification)
GOOGLE_CLIENT_ID=
# Comma-separated audience allow-list. Include every Web/Android OAuth client that can mint ID tokens.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# Google Play In-App Purchase Verification (Real Google Play Developer API)
GOOGLE_PLAY_PACKAGE_NAME=com.quizzyfox.game
# Path to Google Play service account JSON key file (relative or absolute):
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
# Or provide inline JSON credentials:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=play-billing-service@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Groq AI Configuration (Quick Quiz AI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
