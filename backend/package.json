{
  "name": "quizgame-backend",
  "version": "1.0.0",
  "description": "Node.js, Express, MySQL, and Socket.io backend for the QuizGame Expo app.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/runSqlFile.js migrations/001_initial_schema.sql",
    "db:migrate:all": "node src/db/runSqlFiles.js migrations",
    "db:migrate:room-name": "node src/db/runSqlFile.js migrations/009_add_room_name.sql",
    "db:migrate:challenges": "node src/db/runSqlFile.js migrations/005_challenges.sql",
    "db:migrate:admin": "node src/db/runSqlFile.js migrations/006_admin_user.sql",
    "db:migrate:categories": "node src/db/runSqlFile.js migrations/007_categories_and_remove_demo_data.sql",
    "db:seed": "node src/db/runSqlFile.js migrations/002_seed_data.sql",
    "db:seed:questions": "node src/db/runSqlFile.js migrations/011_seed_questions.sql",
    "db:migrate:reset-tokens": "node src/db/runSqlFile.js migrations/010_password_reset_tokens.sql",
    "db:migrate:auth": "node src/db/runSqlFile.js migrations/021_secure_auth_architecture.sql",
    "questions:import": "node src/scripts/importQuestions.js",
    "avatars:optimize": "node src/scripts/optimizeUploadedAvatars.js",
    "test": "node --test --test-concurrency=1 test/*.test.js tests/*.test.js",
    "admin:seed": "node src/scripts/seedAdmin.js",
    "check": "node src/scripts/checkSyntax.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "mysql2": "^3.22.3",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
